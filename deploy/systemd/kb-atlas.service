[Unit]
Description=KB Atlas — staticki vizuelni pregled oba KB corpusa
Documentation=file:/opt/kb/kb_atlas.py
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kb/atlas
ExecStart=/usr/bin/python3 -m http.server 3085 --bind 192.168.1.174 --directory /opt/kb/atlas
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
